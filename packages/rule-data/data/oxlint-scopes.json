{
  "scopes": {
    "eslint": { "oxlintPlugin": "eslint", "eslintPrefix": null, "aliasPrefixes": [], "configPrefixes": ["eslint"] },
    "import": { "oxlintPlugin": "import", "eslintPrefix": "import-x", "aliasPrefixes": ["import"], "configPrefixes": ["import", "import-x"] },
    "jest": { "oxlintPlugin": "jest", "eslintPrefix": "jest", "aliasPrefixes": [], "configPrefixes": ["jest"] },
    "jsdoc": { "oxlintPlugin": "jsdoc", "eslintPrefix": "jsdoc", "aliasPrefixes": [], "configPrefixes": ["jsdoc"] },
    "jsx_a11y": { "oxlintPlugin": "jsx-a11y", "eslintPrefix": "jsx-a11y", "aliasPrefixes": [], "configPrefixes": ["jsx_a11y", "jsx-a11y"] },
    "nextjs": { "oxlintPlugin": "nextjs", "eslintPrefix": "@next/next", "aliasPrefixes": [], "configPrefixes": ["nextjs", "@next/next", "@next"] },
    "node": { "oxlintPlugin": "node", "eslintPrefix": "n", "aliasPrefixes": [], "configPrefixes": ["node"] },
    "oxc": { "oxlintPlugin": "oxc", "eslintPrefix": "oxc", "aliasPrefixes": [], "configPrefixes": ["oxc", "deepscan"] },
    "promise": { "oxlintPlugin": "promise", "eslintPrefix": "promise", "aliasPrefixes": [], "configPrefixes": ["promise"] },
    "react": { "oxlintPlugin": "react", "eslintPrefix": "react", "aliasPrefixes": [], "configPrefixes": ["react", "react-hooks"] },
    "react_perf": { "oxlintPlugin": "react-perf", "eslintPrefix": "react-perf", "aliasPrefixes": [], "configPrefixes": ["react_perf", "react-perf"] },
    "typescript": { "oxlintPlugin": "typescript", "eslintPrefix": "@typescript-eslint", "aliasPrefixes": [], "configPrefixes": ["typescript", "@typescript-eslint", "typescript-eslint"] },
    "unicorn": { "oxlintPlugin": "unicorn", "eslintPrefix": "unicorn", "aliasPrefixes": [], "configPrefixes": ["unicorn"] },
    "vitest": { "oxlintPlugin": "vitest", "eslintPrefix": "vitest", "aliasPrefixes": [], "configPrefixes": ["vitest"] },
    "vue": { "oxlintPlugin": "vue", "eslintPrefix": "vue", "aliasPrefixes": [], "configPrefixes": ["vue"] }
  },
  "coreRulesExtendedByTypescript": [
    "class-methods-use-this",
    "default-param-last",
    "init-declarations",
    "max-params",
    "no-array-constructor",
    "no-dupe-class-members",
    "no-empty-function",
    "no-invalid-this",
    "no-loop-func",
    "no-loss-of-precision",
    "no-magic-numbers",
    "no-redeclare",
    "no-restricted-imports",
    "no-shadow",
    "no-unused-expressions",
    "no-unused-vars",
    "no-use-before-define",
    "no-useless-constructor"
  ],
  "canonicalIdByOxlintName": {
    "react/capitalized-calls": "react-hooks/capitalized-calls",
    "react/error-boundaries": "react-hooks/error-boundaries",
    "react/exhaustive-deps": "react-hooks/exhaustive-deps",
    "react/exhaustive-effect-dependencies": "react-hooks/exhaustive-effect-dependencies",
    "react/globals": "react-hooks/globals",
    "react/hooks": "react-hooks/hooks",
    "react/immutability": "react-hooks/immutability",
    "react/incompatible-library": "react-hooks/incompatible-library",
    "react/invariant": "react-hooks/invariant",
    "react/memo-dependencies": "react-hooks/memo-dependencies",
    "react/no-deriving-state-in-effects": "react-hooks/no-deriving-state-in-effects",
    "react/only-export-components": "react-refresh/only-export-components",
    "react/preserve-manual-memoization": "react-hooks/preserve-manual-memoization",
    "react/purity": "react-hooks/purity",
    "react/refs": "react-hooks/refs",
    "react/rule-suppression": "react-hooks/rule-suppression",
    "react/rules-of-hooks": "react-hooks/rules-of-hooks",
    "react/set-state-in-effect": "react-hooks/set-state-in-effect",
    "react/set-state-in-render": "react-hooks/set-state-in-render",
    "react/static-components": "react-hooks/static-components",
    "react/syntax": "react-hooks/syntax",
    "react/todo": "react-hooks/todo",
    "react/unsupported-syntax": "react-hooks/unsupported-syntax",
    "react/use-memo": "react-hooks/use-memo",
    "react/void-use-memo": "react-hooks/void-use-memo",
    "unicorn/no-array-for-each": "unicorn/no-for-each",
    "unicorn/prefer-dom-node-dataset": "unicorn/dom-node-dataset"
  },
  "eslintAliasesByOxlintName": {
    "unicorn/prefer-dom-node-dataset": ["unicorn/prefer-dom-node-dataset"]
  }
}
