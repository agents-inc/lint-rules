{
  "name": "@agents-inc/lint-rules",
  "version": "0.1.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^22.18.0 || >=24"
  },
  "bin": {
    "agents-inc-lint": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./eslint": {
      "types": "./dist/eslint.d.mts",
      "import": "./dist/eslint.mjs"
    },
    "./oxlint": {
      "types": "./dist/oxlint.d.mts",
      "import": "./dist/oxlint.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "bun run build && bun run typecheck && bun run test"
  },
  "peerDependencies": {
    "typescript": ">=4.8.4 <6.1.0"
  },
  "//dependencies": "@typescript-eslint/utils is imported by eslint-plugin-house, which the build inlines. Undeclared here, tsdown tries to inline it too and the declaration build fails (MISSING_EXPORT from typescript.d.ts).",
  "dependencies": {
    "@eslint-react/eslint-plugin": "5.26.5",
    "@eslint/compat": "2.1.1",
    "@typescript-eslint/utils": "8.71.1",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.12.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-css-modules": "2.12.0",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-no-secrets": "2.3.3",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hook-form": "0.3.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-perf": "3.3.3",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.2",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-storybook": "10.6.1",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "78.0.0",
    "globals": "17.13.0",
    "oxlint": "1.87.0",
    "typescript-eslint": "8.71.1"
  },
  "//devDependencies": "The @workspace packages are inlined by the build (tsdown deps.alwaysBundle); under dependencies a consumer's install would try to fetch them.",
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/semver": "7.8.0",
    "@workspace/eslint-plugin-house": "workspace:*",
    "@workspace/rule-data": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "semver": "7.8.5",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
