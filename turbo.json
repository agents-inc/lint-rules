{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^build", "//#unused-exports"]
    },
    "//#unused-exports": {
      "cache": false
    },
    "//#typecheck-scripts": {
      "dependsOn": ["//#unused-exports", "@agents-inc/lint-rules#build"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
